<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <!-- LOGO INJECT HERE -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/tvAdminGreeting" style="@style/Body" android:text="Admin console" />
                <TextView android:id="@+id/tvAdminName" style="@style/Heading" android:text="Admin" />
                <TextView style="@style/Body" android:text="The Repairmate · QuickFix Tech Solutions" android:textSize="12sp" />
            </LinearLayout>
            <com.example.therepairmate.ui.GlassIconView android:id="@+id/iconLogout" android:layout_width="52dp" android:layout_height="52dp"
                android:contentDescription="Sign out" app:glassIcon="@drawable/ic_logout" app:glassTint="#7B3FE4" />
        </LinearLayout>

        <!-- KPIs -->
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="2" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:layout_margin="5dp" android:background="@drawable/bg_glass_card">
                <TextView android:id="@+id/kActive" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/qf_blue" />
                <TextView style="@style/Body" android:text="Active repairs" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:layout_margin="5dp" android:background="@drawable/bg_glass_card">
                <TextView android:id="@+id/kUnassigned" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/qf_warning" />
                <TextView style="@style/Body" android:text="Unassigned" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:layout_margin="5dp" android:background="@drawable/bg_glass_card">
                <TextView android:id="@+id/kReady" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/qf_success" />
                <TextView style="@style/Body" android:text="Ready for pickup" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:layout_margin="5dp" android:background="@drawable/bg_glass_card">
                <TextView android:id="@+id/kCompleted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/qf_white" />
                <TextView style="@style/Body" android:text="Completed" />
            </LinearLayout>
        </GridLayout>

        <!-- Pipeline (estimate, not revenue) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:layout_marginTop="10dp" android:background="@drawable/bg_hero">
            <TextView style="@style/Body" android:text="ESTIMATED PIPELINE · ACTIVE REPAIRS" android:textColor="@color/qf_text2"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />
            <TextView android:id="@+id/tvPipeline" style="@style/Heading" android:textSize="28sp" android:text="R0" android:layout_marginTop="4dp" />
            <TextView style="@style/Body" android:textColor="@color/qf_text2" android:layout_marginTop="4dp"
                android:text="Sum of customer estimates. This is not revenue: payments are not recorded yet." />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="Repairs by status" android:layout_marginTop="24dp" />
        <LinearLayout android:id="@+id/statusList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:layout_marginTop="10dp" android:background="@drawable/bg_glass_card" />

        <TextView style="@style/SectionTitle" android:text="Technician workload" android:layout_marginTop="24dp" />
        <LinearLayout android:id="@+id/techList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:layout_marginTop="10dp" android:background="@drawable/bg_glass_card" />

        <TextView style="@style/SectionTitle" android:text="Needs a technician" android:layout_marginTop="24dp" />
        <TextView android:id="@+id/tvAllAssigned" style="@style/Body" android:text="All active repairs are assigned." android:layout_marginTop="8dp" />
        <LinearLayout android:id="@+id/unassignedList" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="10dp" />

        <Button android:id="@+id/btnManage" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="16dp" android:text="Manage all repairs" android:background="@drawable/bg_button"
            app:backgroundTint="@null" android:textColor="@color/qf_white" android:textAllCaps="false" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>