<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="148dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:layout_marginEnd="12dp"
    android:background="@drawable/bg_glass_card" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/ivService" android:layout_width="44dp" android:layout_height="44dp"
        android:padding="11dp" android:background="@drawable/bg_circle_grad" android:importantForAccessibility="no" />
    <TextView android:id="@+id/tvServiceName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="@color/qf_white" android:textStyle="bold" android:textSize="15sp" />
    <TextView android:id="@+id/tvServicePrice" style="@style/Body" android:layout_marginTop="2dp" android:textSize="12sp" />
</LinearLayout>