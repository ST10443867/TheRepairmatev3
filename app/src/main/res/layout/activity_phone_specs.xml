<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:fitsSystemWindows="true">

    <TextView
        style="@style/Heading"
        android:text="Phone Specifications Explorer"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:hint="Search phone model (e.g. iPhone 12)"
            android:textColorHint="@color/qf_muted"
            android:textColor="@color/qf_white"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_glass_card"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="Search"
            android:background="@drawable/bg_button"
            android:textColor="@color/qf_white"
            android:textAllCaps="false" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/Body"
        android:layout_gravity="center"
        android:padding="24dp"
        android:text="Search for a phone or browse latest devices below"
        android:visibility="gone" />

    <TextView
        style="@style/SectionTitle"
        android:text="Latest Devices"
        android:layout_marginTop="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="vertical" />

</LinearLayout>
