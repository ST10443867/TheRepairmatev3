<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="6dp">
    <TextView android:id="@+id/tvBarLabel" android:layout_width="120dp" android:layout_height="wrap_content"
        android:textColor="@color/qf_white" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/barIndicator"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        app:trackThickness="8dp" app:trackCornerRadius="4dp" app:trackColor="#26FFFFFF" app:indicatorColor="@color/qf_blue" />
    <TextView android:id="@+id/tvBarCount" android:layout_width="36dp" android:layout_height="wrap_content"
        android:gravity="end" android:textColor="@color/qf_white" android:textStyle="bold" />
</LinearLayout>